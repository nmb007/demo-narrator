ENVIRONMENT=local

# Postgres / Redis — Compose service hostnames (api & worker resolve db/redis on the network)
DATABASE_URL=postgresql+psycopg://postgres:postgres@db:5432/narrator
CELERY_BROKER_URL=redis://redis:6379/0

# Auth
AUTH_JWT_SECRET=change-me-in-production
AUTH_JWT_ALG=HS256
AUTH_JWT_EXP_MINUTES=60

# Storage — local dev
STORAGE_URL=file:///app/storage

# Storage — Supabase / S3-compatible (production)
# STORAGE_URL=s3://your-bucket
# STORAGE_S3_ENDPOINT=https://<project>.supabase.co/storage/v1/s3
# STORAGE_S3_REGION=us-east-1
# STORAGE_S3_ACCESS_KEY_ID=
# STORAGE_S3_SECRET_ACCESS_KEY=

# Narration limits
NARRATION_KEEP_FINALS=2
NARRATION_MAX_UPLOAD_BYTES=104857600
NARRATION_MAX_DURATION_SECONDS=600
NARRATION_MIN_DURATION_SECONDS=2
NARRATION_WHISPER_MODEL=small
NARRATION_DEFAULT_VOICE=en-US-AndrewNeural

# Groq rewrite
GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b
